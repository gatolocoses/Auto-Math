{
  "manifest_version": 3,
  "name": "Inline Math Evaluator",
  "description": "Auto-completes math equations in inputs and textareas when a line ends with '=  '. Only capital X is supported for multiplication.",
  "version": "1.0.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "inline-math-evaluator@gatolocoses.github.io",
      "strict_min_version": "128.0"
    }
  },
  "action": {
    "default_title": "Inline Math Evaluator"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["math.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
